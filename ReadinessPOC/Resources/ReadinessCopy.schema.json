{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://readinesspoc.local/schemas/ReadinessCopy.schema.json",
  "title": "Readiness Copy Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "reasons", "missingLabels", "messages"],
  "properties": {
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": ["day", "night"],
      "properties": {
        "day": { "$ref": "#/$defs/bandTitles" },
        "night": { "$ref": "#/$defs/bandTitles" }
      }
    },
    "reasons": {
      "type": "object",
      "additionalProperties": false,
      "required": ["day", "night"],
      "properties": {
        "day": { "$ref": "#/$defs/factorReasons" },
        "night": { "$ref": "#/$defs/factorReasons" }
      }
    },
    "missingLabels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["day", "night"],
      "properties": {
        "day": { "$ref": "#/$defs/missingLabels" },
        "night": { "$ref": "#/$defs/missingLabels" }
      }
    },
    "messages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["insufficientData", "allHealthDataMissing", "partialDataMissingTemplate"],
      "properties": {
        "insufficientData": {
          "type": "object",
          "additionalProperties": false,
          "required": ["heroSubtitle", "summaryLine"],
          "properties": {
            "heroSubtitle": { "type": "string", "minLength": 1 },
            "summaryLine": { "type": "string", "minLength": 1 }
          }
        },
        "allHealthDataMissing": { "type": "string", "minLength": 1 },
        "partialDataMissingTemplate": {
          "type": "string",
          "pattern": "\\{\\{labels\\}\\}"
        }
      }
    }
  },
  "$defs": {
    "titleParts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "action"],
      "properties": {
        "status": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 }
      }
    },
    "bandTitles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["veryLow", "low", "medium", "good", "high"],
      "properties": {
        "veryLow": { "$ref": "#/$defs/titleParts" },
        "low": { "$ref": "#/$defs/titleParts" },
        "medium": { "$ref": "#/$defs/titleParts" },
        "good": { "$ref": "#/$defs/titleParts" },
        "high": { "$ref": "#/$defs/titleParts" }
      }
    },
    "reasonRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minInclusive", "text"],
      "properties": {
        "minInclusive": { "type": "number" },
        "maxExclusive": { "type": "number" },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "reasonSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ranges"],
      "properties": {
        "valueSource": {
          "type": "string",
          "enum": ["score", "sleepDurationLastNightHours"]
        },
        "ranges": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/reasonRange" }
        }
      }
    },
    "factorReasons": {
      "type": "object",
      "additionalProperties": false,
      "required": ["circadian", "activity", "recovery"],
      "properties": {
        "circadian": { "$ref": "#/$defs/reasonSet" },
        "activity": { "$ref": "#/$defs/reasonSet" },
        "recovery": { "$ref": "#/$defs/reasonSet" }
      }
    },
    "missingLabels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["circadian", "activity", "recovery"],
      "properties": {
        "circadian": { "type": "string", "minLength": 1 },
        "activity": { "type": "string", "minLength": 1 },
        "recovery": { "type": "string", "minLength": 1 }
      }
    }
  }
}
